# Flask
SECRET_KEY=change_me_in_production
DATABASE_URL=sqlite:///users.db

# Mail (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_TIMEOUT=30
MAIL_MAX_EMAILS=1
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# OTX AlienVault
API_KEY=your_otx_api_key
API_URL=https://api.otx.alienvault.com/api/v1/pulses/subscribed
API_EXPORT_URL=https://otx.alienvault.com/api/v1/indicators/export

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Threats
NOTIFY_THRESHOLD=80
THREATS_OUTPUT=recent_threats.json
THREATS_POLL_INTERVAL=60
NOTIFICATION_RETRY_INTERVAL=60

# Auto-blocking configuration
AUTO_BLOCK_ENABLED=true
AUTO_BLOCK_THRESHOLD=75
AUTO_BLOCK_DELAY=10
AUTO_BLOCK_MAX_PER_CYCLE=5

# Security hardening toggles
ENABLE_HARDENING=true

# Agent authentication
AGENT_API_TOKEN=change_me_for_agents
AGENT_REQUIRE_TOKEN=true
